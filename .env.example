# Boma Bot — copy to `.env` for local runs. Never commit a real `.env`.
# Everything here is read once at startup and validated; a bad value stops the process.

# Listener. Loopback by default: publishing the API is a deliberate act.
BOMA_BIND_ADDR=127.0.0.1:3000

# Postgres. The password is part of this string and is never logged (REQ-054).
BOMA_DATABASE_URL=postgres://boma:boma@127.0.0.1:5432/boma
BOMA_DB_MAX_CONNECTIONS=10
BOMA_DB_ACQUIRE_TIMEOUT_MS=5000

# Request bounds. The body limit is raised per route, never globally (D-07).
BOMA_REQUEST_TIMEOUT_MS=30000
BOMA_READINESS_TIMEOUT_MS=5000
BOMA_MAX_BODY_BYTES=65536
# Comma-separated peers whose x-forwarded-* headers are believed. Empty means none (D-04).
BOMA_TRUSTED_PROXIES=

# Logging: json for a collector, pretty for a terminal.
BOMA_LOG_FORMAT=pretty
BOMA_LOG_FILTER=info

# What `/ready` reports. Secrets never go here; this is a capability list, not credentials.
BOMA_VERSION=0.1.0
BOMA_REVISION=
BOMA_RUNTIME=sandboxed
# The computer backend (REQ-027). `docker` needs a reachable daemon; `none` is the default and
# answers `computers unavailable` rather than pretending.
SANDBOX_PROVIDER=none
BOMA_INTEGRATIONS=
BOMA_MESSAGING=false
BOMA_EMAIL=
BOMA_BILLING=false
# The pro plan and its checkout (REQ-051) and the spending limit (REQ-018). Stripe settings are
# all or none: a half-configured provider is a startup error, not a deployment that quietly
# refuses checkouts. `BOMA_BILLING_STRIPE_PRICE_PRO` is the price of the pro plan (price_…);
# `BOMA_BILLING_WEBHOOK_SECRET` is the endpoint secret (whsec_…) and must be at least 16 characters.
BOMA_BILLING_PROVIDER=
BOMA_BILLING_STRIPE_SECRET=
BOMA_BILLING_STRIPE_PRICE_PRO=
BOMA_BILLING_WEBHOOK_SECRET=
BOMA_JOBS=inline
BOMA_REALTIME=postgres
BOMA_DEGRADED=false
# The ticket board (REQ-038). Off: the board surface does not exist, signed in or not.
BOMA_BOARD=false

# Inbound mail for bots (REQ-047). Both or neither — a half-configured relay refuses to boot.
# The relay posts RFC 822 messages to POST /api/v1/email/inbound with a Bearer token; bots are
# reachable at `boma+<botId>@<BOMA_EMAIL_DOMAIN>`. The token must be at least 16 characters.
BOMA_EMAIL_RELAY_TOKEN=
BOMA_EMAIL_DOMAIN=

# Messaging platforms (REQ-048). Off: the messaging routes and procedures do not exist.
# The deployment's public base URL, used for the webhook URLs members paste into a platform.
BOMA_PUBLIC_BASE_URL=http://127.0.0.1:3000
# Credentials of one Slack app, all three or none. Without them Telegram and generic
# installations still work; Slack installs refuse with a clear error.
BOMA_SLACK_CLIENT_ID=
BOMA_SLACK_CLIENT_SECRET=
BOMA_SLACK_SIGNING_SECRET=
# The Slack app's registered redirect URI. Must match exactly; defaults to this deployment's callback.
BOMA_SLACK_REDIRECT_URI=
BOMA_MESSAGING=true

# Local MCP servers (REQ-033). Comma-separated bare program names this deployment allows to run
# as stdio MCP servers (e.g. `python3,node`). Empty refuses every stdio server, which is the
# default and the recommendation; a remote HTTPS server is the supported path otherwise.
MCP_STDIO_ALLOWED_COMMANDS=

# Bot secrets vault (REQ-046). Envelope encryption: every space owns a random data key wrapped
# under this master key; secrets are sealed under their space's key. Exactly 64 hex characters.
# When unset, a per-process ephemeral key is used (tests and local development only) and a warning
# is logged — never ship a deployment built on an ephemeral key. Losing this key loses every
# secret. Rotation: `boma rekey` re-wraps the data keys under BOMA_NEW_MASTER_KEY (secrets are
# not re-encrypted), then swap this value and restart.
BOMA_MASTER_KEY=

# The bring-your-own-key provider (REQ-015). All three or none: a half-configured provider is a
# startup error, not a silent downgrade to the scripted agent. The key is a secret and never
# appears in logs; leave empty to run the scripted provider end to end.
BOMA_PROVIDER_ENDPOINT=
BOMA_PROVIDER_MODEL=
BOMA_PROVIDER_API_KEY=

# The operator's counters at GET /metrics (REQ-054). Off by default: without the flag the
# exposition answers 404, signed in or not. Meant for a private scrape (loopback or the
# monitoring network); it is intentionally not in the OpenAPI document.
BOMA_METRICS=false

# SCIM 2.0 directory sync (REQ-045). Both or neither: a half-configured enterprise directory
# refuses to boot rather than answer 404 with its mouth full. The token belongs to the IdP, it
# signs provision, deprovision and list calls, and it is never the same value as BOMA_RELAY.
BOMA_SCIM=false
BOMA_SCIM_TOKEN=

# The static web export the binary serves at the deployment origin (REQ-055, ADR-013).
# Empty = the API only (every non-API path is the JSON 404). When set, it must point at the
# directory that holds the export's index.html; a missing directory is a startup error.
BOMA_WEB_ROOT=

# Password recovery (REQ-040). This deployment has no outbound mail; when this is true, each
# request writes ONE line to the process output with the account id and the link. Never logs the
# address. The link is single-use and dies in 30 minutes.
BOMA_AUTH_PRINT_RESET_LINK=false

# Invitations (REQ-042). Same pattern for invites: `true` prints ONE line per invited person
# with the inviter id and the link, never the invited address.
BOMA_SPACES_PRINT_INVITE_LINK=false
