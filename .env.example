# Boma Bot — copy to `.env` for local runs. Never commit a real `.env`.
# Everything here is read once at startup and validated; a bad value stops the process.

# Listener. Loopback by default: publishing the API is a deliberate act.
BOMA_BIND_ADDR=127.0.0.1:3000

# Postgres. The password is part of this string and is never logged (REQ-054).
BOMA_DATABASE_URL=postgres://boma:boma@127.0.0.1:5432/boma
BOMA_DB_MAX_CONNECTIONS=10
BOMA_DB_ACQUIRE_TIMEOUT_MS=5000

# Request bounds. The body limit is raised per route, never globally (D-07).
BOMA_REQUEST_TIMEOUT_MS=30000
BOMA_READINESS_TIMEOUT_MS=5000
BOMA_MAX_BODY_BYTES=65536
# Comma-separated peers whose x-forwarded-* headers are believed. Empty means none (D-04).
BOMA_TRUSTED_PROXIES=

# Logging: json for a collector, pretty for a terminal.
BOMA_LOG_FORMAT=pretty
BOMA_LOG_FILTER=info

# What `/ready` reports. Secrets never go here; this is a capability list, not credentials.
BOMA_VERSION=0.1.0
BOMA_REVISION=
BOMA_RUNTIME=sandboxed
# The computer backend (REQ-027). `docker` needs a reachable daemon; `none` is the default and
# answers `computers unavailable` rather than pretending.
SANDBOX_PROVIDER=none
BOMA_INTEGRATIONS=
BOMA_MESSAGING=false
BOMA_EMAIL=
BOMA_BILLING=
BOMA_JOBS=inline
BOMA_REALTIME=postgres
BOMA_DEGRADED=false

# The bring-your-own-key provider (REQ-015). All three or none: a half-configured provider is a
# startup error, not a silent downgrade to the scripted agent. The key is a secret and never
# appears in logs; leave empty to run the scripted provider end to end.
BOMA_PROVIDER_ENDPOINT=
BOMA_PROVIDER_MODEL=
BOMA_PROVIDER_API_KEY=
